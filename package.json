{
  "name": "talk-to-the-moon",
  "version": "0.1.0",
  "description": "An AI assistant that drives a 3D map of the Moon, built with the ArcGIS Maps SDK for JavaScript.",
  "repository": "github:balumuriraj/talk-to-the-moon",
  "private": true,
  "license": "MIT",
  "type": "module",
  "browserslist": [
    "Chrome >= 123",
    "Edge >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ],
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build",
    "start": "next start --port 3006",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@arcgis/ai-components": "5.2.4",
    "@arcgis/charts-components": "5.2.4",
    "@arcgis/core": "5.2.4",
    "@arcgis/map-components": "5.2.4",
    "@esri/calcite-components": "^5.2.0",
    "next": "16.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9"
  }
}
